# ---------------------------------------------------------------------------
# AI Provider: Google Gemini AI (via @google/genai SDK)
# ---------------------------------------------------------------------------

# Free API key: Google Gemini. Create a key at https://aistudio.google.com/apikey
# Note: on Gemini's free tier, Google may use your prompts to improve its products.
GEMINI_API_KEY=

# Optional: override default free model (defaults to gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview   # or gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Web search: Tavily (free key at https://app.tavily.com)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# Optional. "basic" uses fewer Tavily credits; "advanced" finds better passages.
# TAVILY_SEARCH_DEPTH=advanced
