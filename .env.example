# ---------------------------------------------------------------------------
# AI provider: set ONE key. HyperLex picks the provider from whichever key
# is present (Gemini first, then Groq, then Mistral).
# ---------------------------------------------------------------------------

# Recommended, free: Google Gemini. Create a key at https://aistudio.google.com/apikey
# Note: on Gemini's free tier, Google may use your prompts to improve its products.
GEMINI_API_KEY=

# Alternative, free: Groq. Create a key at https://console.groq.com/keys
# The free plan allows about 8K tokens per minute, so expect roughly one answer a minute.
# GROQ_API_KEY=

# Mistral: API keys only work on a paid plan or with pay-as-you-go turned on.
# MISTRAL_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini          # gemini | groq | mistral | custom (forces a provider)
# LLM_MODEL=gemini-3.5-flash-lite   # use a different model from the same provider

# Any other OpenAI-compatible API (OpenRouter, Cerebras, a local server...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-key

# ---------------------------------------------------------------------------
# Web search: Tavily (free key at https://app.tavily.com)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# Optional. "basic" uses fewer Tavily credits; "advanced" finds better passages.
# TAVILY_SEARCH_DEPTH=advanced
